# examples/* are standalone apps (see examples/README.md) whose other
# dependencies are free to drift with npm's registry, so a committed
# lockfile would go stale. Each example has its own .gitignore for its own
# build output; this only needs to cover what those don't.
examples/*/pnpm-lock.yaml
